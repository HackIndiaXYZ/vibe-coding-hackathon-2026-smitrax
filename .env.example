# App
APP_PUBLIC_URL=http://localhost:3000
NODE_ENV=development
PATCHPILOT_DATA_FILE=.patchpilot/patchpilot.db.json
PATCHPILOT_LOG_DIR=.patchpilot/logs
PATCHPILOT_WORKSPACE_DIR=.patchpilot/workspaces

# Durable persistence (opt-in; default = local JSON file).
# Start the containers with: docker compose up -d
# Then set PATCHPILOT_PERSIST_POSTGRES=true to mirror state into Postgres (durable
# system of record); the local file remains the working copy. Verify: pnpm verify:postgres
PATCHPILOT_PERSIST_POSTGRES=false
DATABASE_URL=postgresql://patchpilot:patchpilot@localhost:5432/patchpilot

# Durable queue/scheduler (opt-in; default = local inline mode).
# Set PATCHPILOT_QUEUE_MODE=redis to use the Redis/BullMQ durable queue + watch
# schedule (survives restarts). Verify: pnpm verify:queue
REDIS_URL=redis://localhost:6379
PATCHPILOT_QUEUE_MODE=local

# GitHub
GITHUB_TOKEN=
PATCHPILOT_TEST_REPO=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# OpenAI / Codex
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
CODEX_BIN=codex
CODEX_ENABLED=true
CODEX_SANDBOX_MODE=workspace-write
# Default Codex CLI timeout. verify:codex-live defaults to 300000 when this is
# unset; an explicit value here wins for both normal and live runs.
CODEX_TIMEOUT_MS=300000

# Vercel AI SDK / AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5
VERCEL_OIDC_TOKEN=

# BYO model provider layer
# codex = workspace editor (only model allowed to edit the repo)
# openrouter | openai-compatible | ollama = strict-JSON plan advisors (PatchPilot applies the change)
# deterministic = no model; PatchPilot updates the dependency to the OSV-known fixed version
PATCHPILOT_AGENT_PROVIDER=codex
PATCHPILOT_AGENT_MODEL=
PATCHPILOT_LLM_BASE_URL=
PATCHPILOT_LLM_API_KEY=
PATCHPILOT_LLM_TIMEOUT_MS=120000
# Reserved safety switch; even when true PatchPilot still applies the change itself.
PATCHPILOT_LLM_ALLOW_DIRECT_PATCH=false

# Provider failover ladder (safe defaults; ask = consent before lower-trust)
PATCHPILOT_PROVIDER_FAILOVER_MODE=ask
PATCHPILOT_PROVIDER_CHAIN=codex,openrouter,anthropic,grok,openai-compatible,ollama,deterministic
# Per-provider keys/base URLs (optional; fall back to PATCHPILOT_LLM_* where noted)
PATCHPILOT_GROK_API_KEY=
PATCHPILOT_GROK_BASE_URL=https://api.x.ai/v1
PATCHPILOT_ANTHROPIC_API_KEY=
PATCHPILOT_ANTHROPIC_BASE_URL=https://api.anthropic.com
PATCHPILOT_ANTHROPIC_VERSION=2023-06-01
PATCHPILOT_ALLOW_CLOUD_MODEL_FAILOVER=true
PATCHPILOT_ALLOW_LOCAL_MODEL_FAILOVER=false
PATCHPILOT_REQUIRE_CONSENT_FOR_LOWER_TRUST_PROVIDER=true
PATCHPILOT_FAST_FAILOVER=true
PATCHPILOT_PROVIDER_CHAIN_MAX_ATTEMPTS=3
PATCHPILOT_PROVIDER_READINESS_TIMEOUT_MS=3000
PATCHPILOT_PROVIDER_ATTEMPT_TIMEOUT_MS=30000
PATCHPILOT_PROVIDER_READINESS_CACHE_TTL_MS=600000

# Continuous watch mode (disabled by default; never auto-patches)
PATCHPILOT_WATCH_ENABLED=false
PATCHPILOT_WATCH_INTERVAL_MINUTES=60
PATCHPILOT_WATCH_TELEGRAM_ALERTS=true
PATCHPILOT_QUIET_HOURS=

# Scanner orchestration (external tools optional; tool_missing until installed)
PATCHPILOT_SCANNER_OSV_ENABLED=true
PATCHPILOT_SCANNER_OSV_SCANNER_PATH=osv-scanner
PATCHPILOT_SCANNER_GITLEAKS_ENABLED=true
PATCHPILOT_SCANNER_GITLEAKS_PATH=gitleaks
PATCHPILOT_SCANNER_SEMGREP_ENABLED=true
PATCHPILOT_SCANNER_SEMGREP_PATH=semgrep
PATCHPILOT_SCANNER_TRIVY_ENABLED=true
PATCHPILOT_SCANNER_TRIVY_PATH=trivy
PATCHPILOT_SCANNER_SYFT_ENABLED=false
PATCHPILOT_SCANNER_SYFT_PATH=syft
PATCHPILOT_SCANNER_TIMEOUT_MS=120000
PATCHPILOT_MALICIOUS_PACKAGES_DIR=
PATCHPILOT_LICENSE_POLICY_PATH=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
APPROVAL_SIGNING_SECRET=
APPROVAL_HMAC_SECRET=

# Local folder scanning
PATCHPILOT_LOCAL_ROOTS=

# Vulnerability intelligence
OSV_API_URL=https://api.osv.dev/v1/querybatch
NVD_API_URL=
NVD_API_KEY=
GHSA_API_URL=
EPSS_API_URL=https://api.first.org/data/v1/epss
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
OPENSSF_MALICIOUS_PACKAGES_DIR=

# Vercel optional
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# OpenClaw optional
OPENCLAW_BIN=openclaw
OPENCLAW_ENABLED=false

# MCP
PATCHPILOT_MCP_ENABLED=true

# Test/advanced (normally unset)
PATCHPILOT_DISABLE_OSV_SCANNER=
PATCHPILOT_SMOKE_BASE_URL=

# SBOM tools
SYFT_BIN=syft
CYCLONEDX_NPM_BIN=cyclonedx-npm

# Dashboard auth (optional). When set, dashboard + API require this token
# (cookie pp_token / x-patchpilot-token header / Authorization: Bearer / ?token=).
# Unset = open (local dev). The Telegram webhook is exempt (own secret).
PATCHPILOT_DASHBOARD_TOKEN=

# Container image scan (optional, opt-in)
PATCHPILOT_CONTAINER_IMAGE=

# Safety
PATCHPILOT_ALLOW_AUTO_MERGE=false
PATCHPILOT_ALLOW_PROD_DEPLOY=false
PATCHPILOT_APPLY_LOCAL_PATCH_ON_APPROVAL=false
PATCHPILOT_WORKER_MODE=local
PATCHPILOT_RETAIN_WORKSPACES=false
PATCHPILOT_COMMAND_TIMEOUT_MS=120000
# When false (default), npm install lifecycle scripts are ignored during validation.
PATCHPILOT_ALLOW_VALIDATION_SCRIPTS=false
